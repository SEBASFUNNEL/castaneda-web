---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros', label: 'Nosotros' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav" id="nav">
  <div class="container nav__inner">

    <a href="/" class="nav__logo" aria-label="Grupo Castañeda — Inicio">
      <img
        src="/logo-grupo-castaneda-white.png"
        alt="Grupo Castañeda Outsourcing Contable"
        class="nav__logo-img"
        width="1080"
        height="454"
      />
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      {links.map(link => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': isActive(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/conversemos" class="btn nav__cta">Conversemos</a>

    <button class="nav__burger" id="navBurger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span>
    </button>

  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="navMobile" aria-hidden="true">
    {links.map(link => (
      <a href={link.href} class="nav__mobile-link">{link.label}</a>
    ))}
    <a href="/conversemos" class="btn nav__mobile-cta">Conversemos</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 0.5px solid transparent;
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  /* ── Vidrio transparente arriba → azul (navy) al bajar ── */
  .nav.scrolled,
  .nav.is-open {
    background: rgba(26, 43, 74, 0.82);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    box-shadow: 0 2px 24px rgba(26, 43, 74, 0.22);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 108px;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo-img {
    display: block;
    width: auto;
    height: 92px;
    max-width: 520px;
    object-fit: contain;
  }

  /* Links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-left: auto;
  }

  .nav__link {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 0.5px;
    background: var(--color-gold);
    transition: width var(--transition-base);
  }

  .nav__link:hover,
  .nav__link--active { color: var(--color-white); }

  .nav__link:hover::after,
  .nav__link--active::after { width: 100%; }

  /* Al bajar, las letras se aclaran (cambio de color sutil) */
  .nav.scrolled .nav__link,
  .nav.is-open .nav__link { color: rgba(255, 255, 255, 0.82); }
  .nav.scrolled .nav__link:hover,
  .nav.scrolled .nav__link--active,
  .nav.is-open .nav__link:hover,
  .nav.is-open .nav__link--active { color: var(--color-white); }

  /* CTA */
  .nav__cta {
    position: relative;
    isolation: isolate;
    padding: 10px 20px;
    font-size: var(--text-xs);
    background: transparent;
    color: var(--color-white);
    border: 0.5px solid rgba(255, 255, 255, 0.4);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .nav__cta:hover { background: rgba(255, 255, 255, 0.12); }

  /* ── Brillo dorado girando alrededor de la caja (lineal y cíclico) ── */
  @property --cta-glow {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .nav__cta::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 4px;
    padding: 1.5px;
    background: conic-gradient(
      from var(--cta-glow),
      transparent 0deg,
      rgba(200, 154, 60, 0.12) 40deg,
      var(--color-gold) 72deg,
      #fff4d6 88deg,
      var(--color-gold) 104deg,
      transparent 150deg,
      transparent 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    filter: drop-shadow(0 0 3px rgba(200, 154, 60, 0.55));
    animation: cta-orbit 2.8s linear infinite;
    z-index: -1;
    pointer-events: none;
  }
  @keyframes cta-orbit { to { --cta-glow: 360deg; } }

  @media (prefers-reduced-motion: reduce) {
    .nav__cta::before { animation: none; }
  }

  /* Burger */
  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
    padding: 4px;
  }

  .nav__burger span {
    display: block;
    width: 100%;
    height: 0.5px;
    background: var(--color-white);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .nav__burger[aria-expanded="true"] span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__burger[aria-expanded="true"] span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile menu */
  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-6) var(--container-padding) var(--space-8);
    border-top: 0.5px solid rgba(255, 255, 255, 0.12);
    gap: var(--space-4);
    background: transparent;
  }

  .nav__mobile-link {
    font-size: var(--text-base);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    padding-block: var(--space-3);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.12);
  }

  .nav__mobile-cta {
    margin-top: var(--space-2);
    text-align: center;
    justify-content: center;
    background: transparent;
    color: var(--color-white);
    border: 0.5px solid rgba(255, 255, 255, 0.4);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    .nav__logo-img {
      height: 54px;
      max-width: 300px;
    }

    .nav__mobile.is-open {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const burger = document.getElementById('navBurger');
  const mobile = document.getElementById('navMobile');

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    mobile?.classList.toggle('is-open', !open);
    mobile?.setAttribute('aria-hidden', String(open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
