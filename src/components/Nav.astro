---
const links = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros', label: 'Nosotros' },
];
const currentPath = Astro.url.pathname;
---

<header class="nav" id="nav">
  <div class="container nav__inner">

    <a href="/" class="nav__logo" aria-label="Grupo Castañeda — Inicio">
      <span class="nav__logo-gc">GC</span>
      <span class="nav__logo-sep" aria-hidden="true"></span>
      <span class="nav__logo-text">
        <span class="nav__logo-name">Grupo Castañeda</span>
        <span class="nav__logo-sub">Outsourcing Contable</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      {links.map(link => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': currentPath.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/conversemos" class="btn nav__cta">Conversemos</a>

    <button class="nav__burger" id="navBurger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span>
    </button>

  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="navMobile" aria-hidden="true">
    {links.map(link => (
      <a href={link.href} class="nav__mobile-link">{link.label}</a>
    ))}
    <a href="/conversemos" class="btn nav__mobile-cta">Conversemos</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 0.5px solid transparent;
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  /* ── Vidrio transparente arriba → azul (navy) al bajar ── */
  .nav.scrolled,
  .nav.is-open {
    background: rgba(26, 43, 74, 0.82);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    box-shadow: 0 2px 24px rgba(26, 43, 74, 0.22);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 64px;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo-gc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-white);
    line-height: 1;
  }

  .nav__logo-sep {
    width: 0.5px;
    height: 28px;
    background: rgba(255, 255, 255, 0.25);
  }

  .nav__logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav__logo-name {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-white);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .nav__logo-sub {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* Links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-left: auto;
  }

  .nav__link {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 0.5px;
    background: var(--color-gold);
    transition: width var(--transition-base);
  }

  .nav__link:hover,
  .nav__link--active { color: var(--color-white); }

  .nav__link:hover::after,
  .nav__link--active::after { width: 100%; }

  /* Al bajar, las letras se aclaran (cambio de color sutil) */
  .nav.scrolled .nav__link,
  .nav.is-open .nav__link { color: rgba(255, 255, 255, 0.82); }
  .nav.scrolled .nav__link:hover,
  .nav.scrolled .nav__link--active,
  .nav.is-open .nav__link:hover,
  .nav.is-open .nav__link--active { color: var(--color-white); }

  /* CTA */
  .nav__cta {
    padding: 10px 20px;
    font-size: var(--text-xs);
    background: transparent;
    color: var(--color-white);
    border: 0.5px solid rgba(255, 255, 255, 0.4);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .nav__cta:hover { background: rgba(255, 255, 255, 0.12); }

  /* Burger */
  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
    padding: 4px;
  }

  .nav__burger span {
    display: block;
    width: 100%;
    height: 0.5px;
    background: var(--color-white);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .nav__burger[aria-expanded="true"] span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__burger[aria-expanded="true"] span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile menu */
  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-6) var(--container-padding) var(--space-8);
    border-top: 0.5px solid rgba(255, 255, 255, 0.12);
    gap: var(--space-4);
    background: transparent;
  }

  .nav__mobile-link {
    font-size: var(--text-base);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    padding-block: var(--space-3);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.12);
  }

  .nav__mobile-cta {
    margin-top: var(--space-2);
    text-align: center;
    justify-content: center;
    background: transparent;
    color: var(--color-white);
    border: 0.5px solid rgba(255, 255, 255, 0.4);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    .nav__mobile.is-open {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const burger = document.getElementById('navBurger');
  const mobile = document.getElementById('navMobile');

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    mobile?.classList.toggle('is-open', !open);
    mobile?.setAttribute('aria-hidden', String(open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
