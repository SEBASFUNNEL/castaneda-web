---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">

    <div class="footer__brand">
      <a href="/" class="footer__mark" aria-label="Grupo Castañeda - Inicio">
        <img
          src="/logo-gc-mark-white.png"
          alt=""
          class="footer__mark-img"
          width="433"
          height="282"
        />
        <span class="footer__brand-text">
          <span class="footer__logo">Grupo Castañeda</span>
          <span class="footer__tagline">Outsourcing Contable Integral</span>
        </span>
      </a>
      <p class="footer__summary">
        Área contable externa para empresas que necesitan orden, prevención y acompañamiento mensual.
      </p>
    </div>

    <nav class="footer__group" aria-label="Servicios">
      <span class="footer__title">Servicios</span>
      <a href="/servicios" class="footer__link">Contabilidad integral</a>
      <a href="/servicios" class="footer__link">Planillas</a>
      <a href="/servicios" class="footer__link">Tesorería</a>
      <a href="/servicios" class="footer__link">Tributación</a>
    </nav>

    <nav class="footer__group" aria-label="Empresa">
      <span class="footer__title">Empresa</span>
      <a href="/nosotros" class="footer__link">Nosotros</a>
      <a href="/beneficios" class="footer__link">Beneficios</a>
      <a href="/conversemos" class="footer__link">Conversemos</a>
    </nav>

    <div class="footer__group footer__contact">
      <span class="footer__title">Contacto</span>
      <a
        href="https://wa.me/51969357784?text=Hola%2C%20me%20gustar%C3%ADa%20conocer%20m%C3%A1s%20sobre%20sus%20servicios%20contables."
        class="footer__link"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>
      <span class="footer__muted">Lima, Perú</span>
    </div>

  </div>

  <div class="container footer__bottom">
    <p class="footer__copy label">© {year} Grupo Castañeda. Todos los derechos reservados.</p>
    <a href="/conversemos" class="footer__cta">Solicitar diagnóstico</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy);
    padding-block: var(--space-12) var(--space-8);
    border-top: 0.5px solid rgba(229, 224, 214, 0.15);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(260px, 1.25fr) repeat(3, minmax(140px, 0.7fr));
    align-items: start;
    gap: var(--space-10);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    width: fit-content;
    text-decoration: none;
  }

  .footer__mark-img {
    display: block;
    width: auto;
    height: 32px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .footer__brand-text,
  .footer__group {
    display: flex;
    flex-direction: column;
  }

  .footer__brand-text { gap: 2px; }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--color-white);
    line-height: 1.1;
  }

  .footer__tagline {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  .footer__summary {
    max-width: 330px;
    color: rgba(255,255,255,0.46);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .footer__group { gap: var(--space-3); }

  .footer__title {
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__link {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover { color: var(--color-gold); }

  .footer__muted {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.35);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 0.5px solid rgba(255,255,255,0.12);
  }

  .footer__copy {
    color: rgba(255,255,255,0.25);
    font-size: var(--text-xs);
  }

  .footer__cta {
    color: rgba(255,255,255,0.62);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__cta:hover { color: var(--color-gold); }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      text-align: left;
      gap: var(--space-6);
    }

    .footer__brand { grid-column: 1 / -1; }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__copy { text-align: left; }
  }

  @media (max-width: 520px) {
    .footer__inner { grid-template-columns: 1fr; }
  }
</style>
