---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">

    <div class="footer__brand">
      <span class="footer__logo">Grupo Castañeda</span>
      <p class="footer__tagline">Outsourcing Contable Integral</p>
    </div>

    <nav class="footer__nav" aria-label="Navegación del pie de página">
      <a href="/servicios" class="footer__link">Servicios</a>
      <a href="/nosotros" class="footer__link">Nosotros</a>
      <a href="/conversemos" class="footer__link">Conversemos</a>
    </nav>

    <p class="footer__copy label">
      © {year} Grupo Castañeda. Todos los derechos reservados.
    </p>

  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy);
    padding-block: var(--space-12);
    border-top: 0.5px solid rgba(229, 224, 214, 0.15);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--color-white);
    letter-spacing: 0.02em;
  }

  .footer__tagline {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  .footer__nav {
    display: flex;
    gap: var(--space-8);
    align-items: center;
  }

  .footer__link {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-gold);
  }

  .footer__copy {
    text-align: right;
    color: rgba(255,255,255,0.25);
    font-size: var(--text-xs);
  }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-6);
    }

    .footer__nav {
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .footer__copy {
      text-align: center;
    }
  }
</style>
