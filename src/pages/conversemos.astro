---
import Base from '../layouts/Base.astro';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? 'https://formspree.io/f/mgojkkjb';
---

<Base
  title="Conversemos — Grupo Castañeda"
  description="Antes de hablar con nosotros, entérate cómo funciona la primera llamada. Sin compromiso, sin tecnicismos. Solo una conversación honesta sobre tu empresa."
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero">
    <div class="container page-hero__inner page-hero__inner--split">
      <div class="page-hero__copy" data-reveal>
        <span class="eyebrow conv__eyebrow">El primer paso</span>
        <h1 class="page-hero__heading">
          Una conversación honesta<br>
          <em>sobre tu empresa.</em>
        </h1>
        <p class="page-hero__sub">
          No es una presentación de ventas. Es una llamada de 30 minutos
          para entender tu situación y ver si podemos ayudarte — con honestidad.
        </p>
      </div>
      <div class="page-hero__media" data-reveal>
        <figure class="page-hero-photo">
          <img
            src="/images/sala-reunion-castaneda.png"
            alt="Sala de reuniones preparada para conversar con clientes de Grupo Castañeda"
            width="1896"
            height="829"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CÓMO FUNCIONA
  ══════════════════════════════════════════ -->
  <section class="section conv-process" aria-labelledby="process-heading">
    <div class="container">

      <div class="section-header" data-reveal>
        <span class="eyebrow">Qué pasa cuando nos escribes</span>
        <h2 class="section-title" id="process-heading">
          Así funciona<br>la primera llamada.
        </h2>
        <div class="gold-line"></div>
      </div>

      <div class="process__steps" data-stagger>

        <!-- Paso 1 -->
        <div class="process-step">
          <div class="process-step__num" aria-hidden="true">01</div>
          <div class="process-step__body">
            <div class="process-step__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path d="M14 2C7.4 2 2 7.4 2 14s5.4 12 12 12 12-5.4 12-12S20.6 2 14 2z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M10 11c0-2.2 1.8-4 4-4s4 1.8 4 4c0 1.9-1.3 3.4-3 3.9V17" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                <circle cx="14" cy="20.5" r="1" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="process-step__title">Cuéntanos el motivo de tu consulta</h3>
            <p class="process-step__desc">
              En el formulario o por WhatsApp, simplemente dinos qué es lo que te trajo aquí:
              ¿Buscas ordenarte? ¿Tienes un problema con SUNAT? ¿Quieres cambiar de contador?
              ¿Recién estás comenzando?
            </p>
            <p class="process-step__desc">
              No hay respuestas correctas ni incorrectas. Toda la información que compartas
              es estrictamente confidencial.
            </p>
          </div>
        </div>

        <!-- Paso 2 -->
        <div class="process-step">
          <div class="process-step__num" aria-hidden="true">02</div>
          <div class="process-step__body">
            <div class="process-step__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <rect x="3" y="4" width="22" height="20" rx="2" stroke="currentColor" stroke-width="1.2"/>
                <path d="M3 10h22" stroke="currentColor" stroke-width="1.2"/>
                <path d="M8 7V3M20 7V3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                <rect x="7" y="14" width="4" height="4" rx="0.5" stroke="currentColor" stroke-width="1.2"/>
                <rect x="17" y="14" width="4" height="4" rx="0.5" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            </div>
            <h3 class="process-step__title">Prepárate para compartir datos clave</h3>
            <p class="process-step__desc">
              Durante la llamada conversaremos sobre algunos datos esenciales para entender
              tu situación real. No necesitas preparar nada formal, pero es útil que tengas
              en mente:
            </p>
            <ul class="process-step__list">
              <li>Facturación mensual aproximada de tu empresa</li>
              <li>Número de colaboradores en planilla (si aplica)</li>
              <li>Régimen tributario actual (RUS, RER, Mype Tributario, General)</li>
              <li>Si tienes alguna deuda o contingencia tributaria pendiente</li>
              <li>Con quién llevas actualmente la contabilidad</li>
            </ul>
            <div class="process-step__note">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 1C4.13 1 1 4.13 1 8s3.13 7 7 7 7-3.13 7-7-3.13-7-7-7z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M8 5v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="8" cy="11" r="0.8" fill="currentColor"/>
              </svg>
              <span>Toda la información que compartas es confidencial y solo se usa para preparar tu propuesta.</span>
            </div>
          </div>
        </div>

        <!-- Paso 3 -->
        <div class="process-step">
          <div class="process-step__num" aria-hidden="true">03</div>
          <div class="process-step__body">
            <div class="process-step__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path d="M14 3L3 8.5v5.5c0 6.4 4.8 11.4 11 12.7C20.2 25.4 25 20.4 25 14v-5.5L14 3z" stroke="currentColor" stroke-width="1.2"/>
                <path d="M10 14l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="process-step__title">Te invitamos a conocer nuestras oficinas</h3>
            <p class="process-step__desc">
              Al finalizar la llamada, si la conversación fluye y vemos que podemos ser
              el equipo que tu empresa necesita, te extendemos una invitación para visitar
              nuestras oficinas.
            </p>
            <p class="process-step__desc">
              Ahí podemos conversar más en detalle, mostrarte cómo trabajamos y presentarte
              al equipo que se haría cargo de tu cuenta. Sin presiones, solo para que te
              vayas con la seguridad de saber con quién estás trabajando.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       EXPECTATIVAS CLARAS
  ══════════════════════════════════════════ -->
  <section class="expectations" aria-labelledby="expect-heading">
    <div class="container expectations__inner">

      <div class="expectations__text" data-reveal-left>
        <span class="eyebrow">Transparencia ante todo</span>
        <h2 class="section-title" id="expect-heading">
          Lo que puedes esperar<br>de nosotros.
        </h2>
        <div class="gold-line"></div>
        <p>
          Somos directos. Si en la llamada vemos que no somos la opción correcta
          para tu empresa, te lo decimos — y si podemos, te orientamos hacia
          la mejor alternativa.
        </p>
      </div>

      <div class="expectations__list" data-stagger>

        <div class="expect__item">
          <div class="expect__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <strong class="expect__title">Sin tecnicismos innecesarios</strong>
            <p class="expect__desc">Hablamos en lenguaje de empresario, no de contador.</p>
          </div>
        </div>

        <div class="expect__item">
          <div class="expect__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <strong class="expect__title">Propuesta concreta post-llamada</strong>
            <p class="expect__desc">No terminarás la conversación con un "te mandamos algo". Tendrás claridad.</p>
          </div>
        </div>

        <div class="expect__item">
          <div class="expect__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <strong class="expect__title">Cero presión para decidir</strong>
            <p class="expect__desc">Tomate el tiempo que necesites. No hacemos seguimiento agresivo.</p>
          </div>
        </div>

        <div class="expect__item">
          <div class="expect__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <strong class="expect__title">Confidencialidad total</strong>
            <p class="expect__desc">Todo lo que compartes queda entre tú y nuestro equipo. Siempre.</p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       MEDIA — Foto ambiente
  ══════════════════════════════════════════ -->
  <div class="container conv-media" data-reveal>
    <figure class="conv-media__photo">
      <img
        src="/images/equipo-presentacion-contable.png"
        alt="Equipo de Grupo Castañeda presentando indicadores contables en sala de reuniones"
        width="1942"
        height="809"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>

  <!-- ══════════════════════════════════════════
       CTA — Contacto
  ══════════════════════════════════════════ -->
  <section class="section contact-cta" aria-labelledby="contact-heading">
    <div class="container contact-cta__inner">

      <div class="contact-cta__header" data-reveal>
        <span class="eyebrow">¿Listo para conversar?</span>
        <h2 class="section-title" id="contact-heading">
          Escríbenos por el canal<br>que prefieras.
        </h2>
        <div class="gold-line"></div>
        <p class="contact-cta__sub">
          Te respondemos antes de las 24 horas hábiles. Si es urgente,
          el WhatsApp es la vía más rápida.
        </p>
      </div>

      <div class="contact-options" data-stagger>

        <!-- WhatsApp -->
        <a
          href="https://wa.me/51969357784?text=Hola%2C%20me%20gustar%C3%ADa%20conversar%20sobre%20los%20servicios%20contables%20de%20Grupo%20Casta%C3%B1eda."
          class="contact-option contact-option--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="contact-option__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 2C7.4 2 2 7.4 2 14c0 2.2.6 4.3 1.6 6.1L2 26l6.1-1.6c1.8 1 3.8 1.6 5.9 1.6 6.6 0 12-5.4 12-12S20.6 2 14 2z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 11.5c.8 1.8 2.4 4.2 5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="contact-option__text">
            <strong class="contact-option__label">WhatsApp</strong>
            <span class="contact-option__value">+51 969 357 784</span>
            <span class="contact-option__note">Respuesta más rápida · Lun–Vie 9am–6pm</span>
          </div>
          <svg class="contact-option__arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- Email -->
        <a href="mailto:contacto@grupocastaneda.pe" class="contact-option">
          <div class="contact-option__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="3" y="6" width="22" height="16" rx="2" stroke="currentColor" stroke-width="1.2"/>
              <path d="M3 10l11 7 11-7" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
          <div class="contact-option__text">
            <strong class="contact-option__label">Correo electrónico</strong>
            <span class="contact-option__value">contacto@grupocastaneda.pe</span>
            <span class="contact-option__note">Respuesta en menos de 24 horas hábiles</span>
          </div>
          <svg class="contact-option__arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

      </div>

      <!-- Formulario -->
      <div class="contact-form-wrap">
        <div class="contact-form-header">
          <h3 class="contact-form-title">O déjanos tus datos y te contactamos nosotros</h3>
          <p class="contact-form-sub">Cuéntanos brevemente tu situación y te respondemos antes de las 24 horas.</p>
        </div>

        <form
          class="contact__form"
          action={formspreeEndpoint}
          method="POST"
          novalidate
        >
          <input type="hidden" name="_subject" value="Nueva consulta desde Grupo Castañeda" />
          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="nombre">Nombre completo</label>
              <input class="form__input" type="text" id="nombre" name="nombre" placeholder="Juan Pérez" required autocomplete="name"/>
            </div>
            <div class="form__field">
              <label class="form__label" for="empresa">Empresa</label>
              <input class="form__input" type="text" id="empresa" name="empresa" placeholder="Mi Empresa S.A.C." autocomplete="organization"/>
            </div>
          </div>

          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="email">Correo electrónico</label>
              <input class="form__input" type="email" id="email" name="email" placeholder="correo@empresa.pe" required autocomplete="email"/>
            </div>
            <div class="form__field">
              <label class="form__label" for="telefono">Teléfono / WhatsApp</label>
              <input class="form__input" type="tel" id="telefono" name="telefono" placeholder="9XX XXX XXX" autocomplete="tel"/>
            </div>
          </div>

          <div class="form__field">
            <label class="form__label" for="motivo">Motivo de consulta</label>
            <select class="form__input form__select" id="motivo" name="motivo">
              <option value="" disabled selected>¿Qué te trajo aquí?</option>
              <option value="ordenar">Quiero ordenar mi contabilidad</option>
              <option value="cambiar">Quiero cambiar de contador/estudio</option>
              <option value="sunat">Tengo un problema con SUNAT</option>
              <option value="nuevo">Acabo de abrir mi empresa</option>
              <option value="crecer">Estoy creciendo y necesito más apoyo</option>
              <option value="consulta">Solo tengo una consulta puntual</option>
            </select>
          </div>

          <div class="form__field">
            <label class="form__label" for="mensaje">Cuéntanos más (opcional)</label>
            <textarea class="form__input form__textarea" id="mensaje" name="mensaje" placeholder="Describe brevemente tu empresa y lo que necesitas..." rows="4"></textarea>
          </div>

          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off"/>

          <button type="submit" class="btn btn--primary form__submit">
            Enviar consulta
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
      </div>

    </div>
  </section>

</Base>

<style>
  @property --glow-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* ── PAGE HERO ─────────────────────────────── */
  .page-hero {
    background: var(--color-navy);
    padding-top: calc(108px + var(--space-24));
    padding-bottom: var(--space-20);
    position: relative;
    overflow: hidden;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -60px;
    width: 500px;
    height: 500px;
    border: 0.5px solid rgba(200, 154, 60, 0.1);
    border-radius: 50%;
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .page-hero__copy {
    padding-left: clamp(64px, 8vw, 116px);
  }

  .conv__eyebrow { color: var(--color-gold) !important; }

  .page-hero__heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl));
    font-weight: 400;
    color: var(--color-white);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .page-hero__heading em { font-style: italic; color: var(--color-gold); }

  .page-hero__sub {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    max-width: 520px;
  }

  /* ── PROCESS STEPS ─────────────────────────── */
  .process__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: var(--border-thin);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
  }

  .process-step {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-8);
    padding: var(--space-10) var(--space-10);
    border-bottom: var(--border-thin);
    align-items: start;
  }

  .process-step:last-child { border-bottom: none; }

  .process-step:nth-child(even) { background: var(--color-white); }

  .process-step__num {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    color: var(--color-gold);
    opacity: 0.25;
    line-height: 1;
    padding-top: var(--space-2);
  }

  .process-step__body { display: flex; flex-direction: column; gap: var(--space-4); }

  .process-step__icon {
    color: var(--color-gold);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-gold-20);
    border-radius: var(--radius-sm);
  }

  .process-step__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-navy);
    line-height: 1.25;
  }

  .process-step__desc {
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.7;
  }

  .process-step__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-gold);
    margin-block: var(--space-2);
  }

  .process-step__list li {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.55;
    position: relative;
  }

  .process-step__list li::before {
    content: '—';
    position: absolute;
    left: calc(-1 * var(--space-4));
    color: var(--color-gold);
    opacity: 0.5;
  }

  .process-step__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background: var(--color-gold-20);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-navy);
    line-height: 1.5;
  }

  .process-step__note svg { color: var(--color-gold); flex-shrink: 0; margin-top: 2px; }

  /* ── EXPECTATIONS ──────────────────────────── */
  .expectations {
    background: var(--color-navy);
    padding-block: var(--space-20);
  }

  .expectations__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .expectations__text .section-title { color: var(--color-white); }
  .expectations__text .eyebrow { color: var(--color-gold); }
  .expectations__text .gold-line { background: var(--color-gold); }

  .expectations__text p {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-top: var(--space-6);
  }

  .expectations__list { display: flex; flex-direction: column; gap: var(--space-5); }

  .expect__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 0.5px solid rgba(229,224,214,0.12);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .expect__item:hover { border-color: rgba(200,154,60,0.3); }

  .expect__check {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(200,154,60,0.15);
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .expect__title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-white);
    margin-bottom: var(--space-1);
    letter-spacing: 0.02em;
  }

  .expect__desc { font-size: var(--text-sm); color: rgba(255,255,255,0.45); line-height: 1.55; }

  /* ── CONTACT CTA ───────────────────────────── */
  .contact-cta__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    align-items: stretch;
  }

  .contact-cta__header {
    grid-column: 1 / -1;
    max-width: 680px;
    margin-inline: auto;
    text-align: center;
  }

  .contact-cta__header .gold-line { margin-inline: auto; }

  .contact-cta__sub {
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.7;
    margin: var(--space-6) auto 0;
    max-width: 560px;
  }

  .contact-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    margin-bottom: 0;
  }

  .contact-option {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex: 1;
