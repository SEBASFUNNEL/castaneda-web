  /* ── HERO ─────────────────────────────────── */
  .hero {
    background: var(--color-navy);
    padding-top: calc(108px + var(--space-16));
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Retícula editorial muy tenue (sistema gráfico: composición basada en retículas) */
  .hero__mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.045) 0.5px, transparent 0.5px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 0.5px, transparent 0.5px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 45%, #000 20%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 80% at 60% 45%, #000 20%, transparent 100%);
    pointer-events: none;
  }

  .hero__mesh::after {
    content: '';
    position: absolute;
    right: -10vw;
    top: 10%;
    width: 56vw;
    height: 70%;
    background: radial-gradient(closest-side, rgba(200,154,60,0.16), transparent 72%);
    filter: blur(10px);
    pointer-events: none;
  }

  /* Arcos del globo (motivo del logo) girando muy despacio */
  .hero__arcs {
    position: absolute;
    right: -14vw;
    top: 50%;
    width: clamp(560px, 62vw, 980px);
    height: auto;
    transform: translateY(-50%);
    z-index: 0;
    opacity: 0.75;
    pointer-events: none;
    animation: hero-arcs-spin 90s linear infinite;
    transform-origin: 68.9% 62.2%;
  }

  @keyframes hero-arcs-spin {
    from { transform: translateY(-50%) rotate(0deg); }
    to   { transform: translateY(-50%) rotate(360deg); }
  }

  .hero__inner {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(var(--space-10), 5vw, var(--space-20));
    align-items: center;
    padding-bottom: var(--space-16);
    position: relative;
    z-index: 2;
  }

  .hero__content { max-width: 620px; }

  .hero__content .eyebrow { color: var(--color-gold); }

