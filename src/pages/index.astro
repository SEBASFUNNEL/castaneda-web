---
import Base from '../layouts/Base.astro';

const videoUrl = 'https://www.instagram.com/grupocastanedaoc/reel/DYiNz6sAiYl/';
const sectors = [
  { label: 'Comercio y retail', icon: 'retail' },
  { label: 'Restaurantes y cafeterías', icon: 'food' },
  { label: 'Servicios profesionales', icon: 'services' },
  { label: 'Logística y courier', icon: 'logistics' },
  { label: 'Construcción y licitaciones', icon: 'construction' },
  { label: 'Salud y estética', icon: 'health' },
  { label: 'Tecnología', icon: 'technology' },
  { label: 'Importación y distribución', icon: 'import' },
  { label: 'Exportación', icon: 'import' },
  { label: 'Consultoría', icon: 'consulting' },
];
const marqueeSectors = [...sectors, ...sectors];
---

<Base
  title="Grupo Castañeda — Outsourcing Contable Integral en Lima"
  description="Área contable completa para empresas: contabilidad, planillas, tesorería y tributación en un solo equipo, con pre-cierre mensual e informe gerencial. Más de 14 años y 150 empresas. Miraflores, Lima."
>

  <!-- ══════════════════════════════════════════
       1. HERO — Qué hacemos, para quién, CTA
  ══════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__mesh" aria-hidden="true"></div>
    <svg class="hero__arcs" viewBox="0 0 900 900" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="gcArc" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#C89A3C" stop-opacity="0"/>
          <stop offset="0.5" stop-color="#C89A3C" stop-opacity="0.6"/>
          <stop offset="1" stop-color="#C89A3C" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <circle cx="620" cy="560" r="430" stroke="url(#gcArc)" stroke-width="0.8"/>
      <ellipse cx="620" cy="560" rx="430" ry="150" stroke="url(#gcArc)" stroke-width="0.8"/>
      <ellipse cx="620" cy="560" rx="150" ry="430" stroke="url(#gcArc)" stroke-width="0.8"/>
      <ellipse cx="620" cy="560" rx="430" ry="150" stroke="url(#gcArc)" stroke-width="0.6" transform="rotate(-32 620 560)"/>
      <ellipse cx="620" cy="560" rx="430" ry="150" stroke="url(#gcArc)" stroke-width="0.6" transform="rotate(32 620 560)"/>
    </svg>

    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow" data-reveal>Outsourcing contable integral · Miraflores, Lima</span>

        <h1 class="hero__heading" id="hero-heading" data-reveal>
          <span class="hero__line">Tu contador te dice</span>
          <span class="hero__line">cuánto declaras.</span>
          <span class="hero__line hero__line--ask">¿Quién te dice</span>
          <span class="hero__line hero__rotator" aria-live="off"><em class="hero__rotator-word" id="heroWord">cuánto ganas?</em></span>
        </h1>

        <p class="hero__sub" data-reveal>
          Somos el área contable completa de tu empresa: contabilidad, planillas,
          tesorería y tributación en un solo equipo. Pre-cierre cada mes, alertas antes
          de cada vencimiento y un informe gerencial que sí se entiende.
        </p>

        <div class="hero__actions" data-reveal>
          <a href="/conversemos" class="btn btn--primary">
            Agendar un diagnóstico
          </a>
          <a href="/servicios" class="btn btn--outline hero__btn-outline">Ver las cuatro áreas</a>
        </div>
      </div>

      <div class="hero__media" data-reveal>
        <div class="gcp" id="gcPanel" aria-label="Ejemplo de informe mensual de Grupo Castañeda">
          <div class="gcp__head">
            <span class="gcp__brand"><span class="gcp__mark" aria-hidden="true">GC</span>Informe gerencial · octubre</span>
            <span class="gcp__live"><span class="gcp__dot" aria-hidden="true"></span>Al día</span>
          </div>

          <div class="gcp__tabs" role="tablist" aria-label="Áreas del informe">
            <button class="gcp__tab is-active" type="button" role="tab" data-tab="0" aria-selected="true">Contabilidad</button>
            <button class="gcp__tab" type="button" role="tab" data-tab="1" aria-selected="false">Planillas</button>
            <button class="gcp__tab" type="button" role="tab" data-tab="2" aria-selected="false">Tesorería</button>
            <button class="gcp__tab" type="button" role="tab" data-tab="3" aria-selected="false">Tributación</button>
            <span class="gcp__progress" id="gcProgress" aria-hidden="true"></span>
          </div>

          <div class="gcp__body">

            <div class="gcp__panel is-active" data-panel="0" role="tabpanel">
              <div class="gcp__kpi">
                <span class="gcp__kpi-label">Utilidad neta · setiembre</span>
                <span class="gcp__kpi-num">S/ <span data-gc-count="48320">48,320</span></span>
                <span class="gcp__kpi-delta gcp__kpi-delta--up">▲ 12 % frente a agosto</span>
              </div>
              <div class="gcp__chart gcp__bars" aria-hidden="true">
                <div class="gcp__bargroup" style="--v:46%;--g:38%"><i>Abr</i></div>
                <div class="gcp__bargroup" style="--v:54%;--g:41%"><i>May</i></div>
                <div class="gcp__bargroup" style="--v:50%;--g:44%"><i>Jun</i></div>
                <div class="gcp__bargroup" style="--v:63%;--g:46%"><i>Jul</i></div>
                <div class="gcp__bargroup" style="--v:70%;--g:49%"><i>Ago</i></div>
                <div class="gcp__bargroup is-current" style="--v:82%;--g:52%"><i>Set</i></div>
              </div>
              <ul class="gcp__rows">
                <li class="gcp__row gcp__row--ok">Pre-cierre revisado antes de declarar</li>
                <li class="gcp__row gcp__row--ok">Estados financieros entregados el día 8</li>
              </ul>
            </div>

            <div class="gcp__panel" data-panel="1" role="tabpanel" hidden>
              <div class="gcp__kpi">
                <span class="gcp__kpi-label">Trabajadores en planilla</span>
                <span class="gcp__kpi-num"><span data-gc-count="12">12</span></span>
                <span class="gcp__kpi-delta">PLAME de setiembre presentado</span>
              </div>
              <div class="gcp__chart gcp__people" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span class="is-warn"></span><span class="is-warn"></span>
              </div>
              <ul class="gcp__rows">
                <li class="gcp__row gcp__row--ok">CTS y gratificación provisionadas</li>
                <li class="gcp__row gcp__row--ok">AFP, ONP y EsSalud al día</li>
                <li class="gcp__row gcp__row--warn">2 contratos vencen el 31 de octubre</li>
              </ul>
            </div>

            <div class="gcp__panel" data-panel="2" role="tabpanel" hidden>
              <div class="gcp__kpi">
                <span class="gcp__kpi-label">Caja proyectada a 30 días</span>
                <span class="gcp__kpi-num">S/ <span data-gc-count="96400">96,400</span></span>
                <span class="gcp__kpi-delta">Cubre planilla, proveedores e impuestos</span>
              </div>
              <div class="gcp__chart gcp__line" aria-hidden="true">
                <svg viewBox="0 0 320 90" preserveAspectRatio="none">
                  <line x1="0" y1="62" x2="320" y2="62" class="gcp__line-base"/>
                  <path class="gcp__line-area" d="M0 50 C 30 44, 50 58, 80 52 S 130 30, 160 38 S 210 70, 240 60 S 290 22, 320 26 L320 90 L0 90 Z"/>
                  <path class="gcp__line-path" d="M0 50 C 30 44, 50 58, 80 52 S 130 30, 160 38 S 210 70, 240 60 S 290 22, 320 26"/>
                  <circle class="gcp__line-dot" cx="240" cy="60" r="3.5"/>
                </svg>
                <div class="gcp__line-weeks"><i>Sem 1</i><i>Sem 2</i><i>Sem 3</i><i>Sem 4</i></div>
              </div>
              <ul class="gcp__rows">
                <li class="gcp__row gcp__row--ok">Conciliación bancaria cerrada</li>
                <li class="gcp__row gcp__row--warn">Semana 3 ajustada: 2 pagos reprogramados</li>
              </ul>
            </div>

            <div class="gcp__panel" data-panel="3" role="tabpanel" hidden>
              <div class="gcp__alert">
                <span class="gcp__alert-kicker">Dinero detenido</span>
                <span class="gcp__alert-num">S/ <span data-gc-count="12540">12,540</span></span>
                <span class="gcp__alert-text">en tu cuenta de detracciones. Ya se solicitó la liberación.</span>
                <span class="gcp__alert-link">Ver solicitud →</span>
              </div>
              <ul class="gcp__rows">
                <li class="gcp__row gcp__row--ok">PDT 621 de setiembre presentado</li>
                <li class="gcp__row gcp__row--ok">Carta inductiva de SUNAT respondida</li>
                <li class="gcp__row gcp__row--ok">Registro SIRE conciliado</li>
              </ul>
            </div>

          </div>
          <div class="gcp__foot">Datos ilustrativos · así se ve un mes con Grupo Castañeda</div>
        </div>
      </div>
    </div>

    <div class="hero__stats-strip" aria-label="Cifras clave">
      <div class="container hero__stats-inner" data-stagger>
        <div class="hero__stat">
          <span class="hero__stat-num" data-counter="14" data-suffix="+">0</span>
          <span class="hero__stat-label">Años de experiencia</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat">
          <span class="hero__stat-num" data-counter="150" data-suffix="+">0</span>
          <span class="hero__stat-label">Empresas atendidas</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat">
          <span class="hero__stat-num" data-counter="4">0</span>
          <span class="hero__stat-label">Áreas en un solo equipo</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat">
          <span class="hero__stat-num" data-counter="24" data-suffix="h">0</span>
          <span class="hero__stat-label">Respuesta en el día</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       2a. VIDEO — Un servicio integral de calidad
  ══════════════════════════════════════════ -->
  <section class="videoint" aria-labelledby="videoint-heading">
    <div class="container">
      <div class="videoint__head" data-reveal>
        <span class="eyebrow">Conócenos</span>
        <h2 class="videoint__title" id="videoint-heading">Un servicio integral de calidad</h2>
      </div>
      <div class="videoint__media" data-reveal>
        <a
          class="video-card"
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver video institucional de Grupo Castañeda"
        >
          <img
            src="/images/diagnostico-contable-dashboard.png"
            alt="Asesor contable presentando indicadores financieros durante una reunión ejecutiva"
            class="video-card__image"
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
          <span class="video-card__overlay" aria-hidden="true"></span>
          <span class="videoint__play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          </span>
          <span class="video-card__label">Video — Servicios contables</span>
          <span class="video-card__hint">Ver video institucional</span>
        </a>
      </div>

      <div class="videoint__cta" data-reveal>
        <a href="/conversemos" class="btn btn--primary videoint__btn">
          Agendemos una reunión
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       2b. SECTORES — Prueba social: a quiénes atendemos
  ══════════════════════════════════════════ -->
  <section class="sectors" aria-labelledby="sectors-heading">
    <div class="container">

      <div class="sectors__header" data-reveal>
        <h2 class="sectors__title" id="sectors-heading">
          Más de 150 empresas, del Perú y del extranjero, en todos los rubros
        </h2>
      </div>

      <div class="rubros-marquee" aria-label="Rubros en los que trabajamos" data-reveal>
        <div class="rubros-marquee__track" aria-hidden="true">
          {marqueeSectors.map(({ label, icon }) => (
            <div class="sector sector--marquee">
              <span class="sector__icon" aria-hidden="true">
                {icon === 'retail' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M6 7h12l1 13H5L6 7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    <path d="M9 9V6a3 3 0 016 0v3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'services' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.5 5.5l2 2M16.5 16.5l2 2M18.5 5.5l-2 2M7.5 16.5l-2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'logistics' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M2 6h11v10H2zM13 9h4l3 3.5V16h-7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    <circle cx="6.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.2"/>
                    <circle cx="16.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.2"/>
                  </svg>
                )}
                {icon === 'construction' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="4" y="3" width="16" height="18" rx="1" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M9 21v-4h6v4M8 7h2M14 7h2M8 11h2M14 11h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'health' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M12 21S4 14.5 4 9a4 4 0 018-1 4 4 0 018 1c0 5.5-8 12-8 12z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  </svg>
                )}
                {icon === 'technology' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="4" width="18" height="12" rx="1" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M9 20h6M12 16v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'import' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="1.2"/>
                  </svg>
                )}
                {icon === 'food' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M4 8h12v6a5 5 0 01-5 5h-2a5 5 0 01-5-5V8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    <path d="M16 10h2a2 2 0 010 4h-2M7 4v2M10 3v3M13 4v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'consulting' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M16 5.2a3 3 0 010 5.6M21 20c0-2.5-1.5-4.6-3.7-5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  </svg>
                )}
              </span>
              <span class="sector__label">{label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3. EL PROBLEMA — Resonancia con el cliente
  ══════════════════════════════════════════ -->
  <section class="section problem" aria-labelledby="problem-heading">
    <div class="container">

      <div class="section-header" data-reveal>
        <span class="eyebrow">¿Te identificas?</span>
        <h2 class="section-title" id="problem-heading">
          La contabilidad tradicional<br>ya no es suficiente.
        </h2>
        <div class="gold-line"></div>
      </div>

      <div class="problem__grid" data-stagger>

        <div class="problem-card">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="1.2"/>
              <path d="M14 8v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="14" cy="19" r="1" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="problem-card__label">No es solo declarar a fin de mes</h3>
          <p class="problem-card__text">
            Un mal contador solo declara. Un buen contador te ayuda a prevenir
            problemas, ordenar tu empresa y tomar mejores decisiones. Si el tuyo
            solo aparece a fin de mes, estás pagando por la mitad del trabajo.
          </p>
        </div>

        <div class="problem-card problem-card--center">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 3L3 9v7c0 6.5 4.8 11.1 11 12.3C20.2 27.1 25 22.5 25 16V9L14 3z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 14l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="problem-card__label">Un verdadero control</h3>
          <p class="problem-card__text">
            Un mal contador espera al cierre para encontrar problemas. Nosotros
            hacemos un pre-cierre cada mes: revisamos tu información antes de
            declarar, no después, y te decimos cómo está tu empresa de verdad.
          </p>
        </div>

        <div class="problem-card">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 3C8 3 3 8 3 14s5 11 11 11 11-5 11-11S20 3 14 3z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 10c0-2.2 1.8-4 4-4s4 1.8 4 4c0 2-1.5 3.5-3.5 4v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="14.5" cy="22" r="1" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="problem-card__label">El aliado para el éxito</h3>
          <p class="problem-card__text">
            SUNAT ya mira tus ventas por redes, Yape y Plin, y una fiscalización
            no empieza con una visita: empieza con un mensaje en tu buzón
            electrónico. Mereces un equipo que lo lea antes que tú.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3b. TRES CASOS — Precalificación por problema
  ══════════════════════════════════════════ -->
  <section class="section segments" aria-labelledby="segments-heading">
    <div class="container">

      <div class="section-header section-header--center" data-reveal>
        <span class="eyebrow">¿Cuál es tu caso?</span>
        <h2 class="section-title" id="segments-heading">
          Tres situaciones que vemos<br>todas las semanas.
        </h2>
        <div class="gold-line" style="margin-inline: auto;"></div>
      </div>

      <div class="segments__grid" data-stagger>

        <article class="segment">
          <span class="segment__num" aria-hidden="true">01</span>
          <h3 class="segment__title">Tu empresa crece y decides a ciegas</h3>
          <p class="segment__quote">“Tu contador te dice cuánto declaras. ¿Quién te dice cuánto ganas?”</p>
          <p class="segment__desc">
            Cumples, declaras y nada parece roto. Pero nadie te entrega un informe con tu
            margen real, tu utilidad y hacia dónde va la caja. Servicio integral con
            informe gerencial cada mes.
          </p>
          <a
            class="segment__cta"
            href="https://wa.me/51969357784?text=Hola%2C%20quiero%20ver%20los%20n%C3%BAmeros%20reales%20de%20mi%20empresa%20(informe%20gerencial)."
            target="_blank"
            rel="noopener noreferrer"
          >Quiero ver mis números reales →</a>
        </article>

        <article class="segment">
          <span class="segment__num" aria-hidden="true">02</span>
          <h3 class="segment__title">Tienes equipo, no tienes respaldo</h3>
          <p class="segment__quote">“Un mensaje fuera de horario puede terminar en un reclamo de horas extras.”</p>
          <p class="segment__desc">
            Contratas, amonestas y despides sin documentar, y cada contrato vencido es un
            riesgo ante SUNAFIL. Planillas con asesoría laboral preventiva: contratos al
            día, beneficios bien calculados y respuesta ante una inspección.
          </p>
          <a
            class="segment__cta"
            href="https://wa.me/51969357784?text=Hola%2C%20tengo%20trabajadores%20en%20planilla%20y%20quiero%20respaldo%20laboral."
            target="_blank"
            rel="noopener noreferrer"
          >Quiero ordenar mi planilla →</a>
        </article>

        <article class="segment segment--alert">
          <span class="segment__num" aria-hidden="true">03</span>
          <h3 class="segment__title">Tienes dinero detenido en SUNAT</h3>
          <p class="segment__quote">“¿Sabes cuánto dinero tuyo está detenido en SUNAT ahora mismo?”</p>
          <p class="segment__desc">
            Saldo inmovilizado en detracciones, una devolución que nadie pidió o una
            notificación en el buzón que nadie leyó. Liberación de detracciones,
            devoluciones y acompañamiento en fiscalizaciones.
          </p>
          <a
            class="segment__cta"
            href="https://wa.me/51969357784?text=Hola%2C%20quiero%20saber%20cu%C3%A1nto%20dinero%20tengo%20detenido%20en%20SUNAT%20(detracciones%20o%20devoluciones)."
            target="_blank"
            rel="noopener noreferrer"
          >Quiero recuperar ese dinero →</a>
        </article>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
