---
import Base from '../layouts/Base.astro';

const videoUrl = 'https://www.instagram.com/grupocastanedaoc/reel/DY5fvdYjuWf/';
---

<Base
  title="Grupo Castañeda — Outsourcing Contable Integral en Lima"
  description="Contabilidad, planillas, tesorería y tributación integradas. Tu empresa siempre al día, con información real para tomar decisiones. Lima, Perú."
>

  <!-- ══════════════════════════════════════════
       1. HERO — Qué hacemos, para quién, CTA
  ══════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow" data-reveal>Outsourcing Contable Integral · Lima, Perú</span>

        <h1 class="hero__heading" data-reveal>
          ¿Tu contador solo<br>
          <em>aparece a fin de mes?</em>
        </h1>

        <p class="hero__sub" data-reveal>
          Un contador aparece a fin de mes. Nosotros somos tu área contable completa
          —contabilidad, planillas, tesorería y tributación, en un solo equipo— que se
          anticipa a los problemas y te da con qué decidir.
        </p>

        <div class="hero__actions" data-reveal>
          <a href="/conversemos" class="btn btn--primary">
            Conversemos
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/servicios" class="btn btn--outline hero__btn-outline">Ver servicios</a>
        </div>
      </div>

      <div class="hero__media" data-reveal>
        <figure class="hero__image-card">
          <img
            src="/images/contador-oficina-lima.png"
            alt="Especialista contable revisando documentos en una oficina ejecutiva de Lima"
            class="hero__image"
            width="1120"
            height="1408"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
    <div class="hero__rule"></div>
  </section>

  <!-- ══════════════════════════════════════════
       2. STATS BAR
  ══════════════════════════════════════════ -->
  <section class="stats" aria-label="Cifras clave">
    <div class="container stats__inner" data-stagger>
      <div class="stats__item">
        <span class="stats__num" data-counter="10" data-suffix="+">0</span>
        <span class="stats__label">Años de experiencia</span>
      </div>
      <div class="stats__divider" aria-hidden="true"></div>
      <div class="stats__item">
        <span class="stats__num" data-counter="150" data-suffix="+">0</span>
        <span class="stats__label">Empresas atendidas</span>
      </div>
      <div class="stats__divider" aria-hidden="true"></div>
      <div class="stats__item">
        <span class="stats__num" data-counter="4">0</span>
        <span class="stats__label">Áreas integradas</span>
      </div>
      <div class="stats__divider" aria-hidden="true"></div>
      <div class="stats__item">
        <span class="stats__num" data-counter="98" data-suffix="%">0</span>
        <span class="stats__label">Satisfacción de clientes</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       2a. VIDEO — Un servicio integral de calidad
  ══════════════════════════════════════════ -->
  <section class="videoint" aria-labelledby="videoint-heading">
    <div class="container">
      <div class="videoint__head" data-reveal>
        <span class="eyebrow">Conócenos</span>
        <h2 class="videoint__title" id="videoint-heading">Un servicio integral de calidad</h2>
      </div>
      <div class="videoint__media" data-reveal>
        <a
          class="video-card"
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver video institucional de Grupo Castañeda"
        >
          <span class="videoint__play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          </span>
          <span class="video-card__label">Video — Servicios contables</span>
          <span class="video-card__hint">Ver video institucional</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       2b. SECTORES — Prueba social: a quiénes atendemos
  ══════════════════════════════════════════ -->
  <section class="sectors" aria-labelledby="sectors-heading">
    <div class="container">

      <div class="sectors__header" data-reveal>
        <span class="eyebrow">Empresas que confían</span>
        <h2 class="sectors__title" id="sectors-heading">
          Acompañamos a empresas en todos los rubros del Perú y del mundo
        </h2>
      </div>

      <div class="rubros-marquee" aria-label="Rubros en los que trabajamos" data-reveal>
        <div class="rubros-marquee__track" aria-hidden="true">
          {[
            'Comercio y retail',
            'Servicios',
            'Logística',
            'Construcción',
            'Salud',
            'Tecnología',
            'Importación',
            'Consultoría',
            'Comercio y retail',
            'Servicios',
            'Logística',
            'Construcción',
            'Salud',
            'Tecnología',
            'Importación',
            'Consultoría',
          ].map((label) => (
            <div class="sector sector--marquee">
              <span class="sector__icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect x="4" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M8 10h8M8 14h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="sector__label">{label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       3. EL PROBLEMA — Resonancia con el cliente
  ══════════════════════════════════════════ -->
  <section class="section problem" aria-labelledby="problem-heading">
    <div class="container">

      <div class="section-header" data-reveal>
        <span class="eyebrow">¿Te identificas?</span>
        <h2 class="section-title" id="problem-heading">
          La contabilidad tradicional<br>ya no es suficiente.
        </h2>
        <div class="gold-line"></div>
      </div>

      <div class="problem__grid" data-stagger>

        <div class="problem-card">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="1.2"/>
              <path d="M14 8v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="14" cy="19" r="1" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="problem-card__label">No es solo declarar a fin de mes</h3>
          <p class="problem-card__text">
            Solo recibes declaraciones una vez al mes. Nunca un análisis,
            nunca una alerta, nunca un "ojo con esto".
          </p>
        </div>

        <div class="problem-card problem-card--center">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 3L3 9v7c0 6.5 4.8 11.1 11 12.3C20.2 27.1 25 22.5 25 16V9L14 3z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 14l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="problem-card__label">Un verdadero control</h3>
          <p class="problem-card__text">
            No sabes realmente si tu empresa está bien. Tomas decisiones
            de inversión, contratación o crédito sin información confiable.
          </p>
        </div>

        <div class="problem-card">
          <div class="problem-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 3C8 3 3 8 3 14s5 11 11 11 11-5 11-11S20 3 14 3z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 10c0-2.2 1.8-4 4-4s4 1.8 4 4c0 2-1.5 3.5-3.5 4v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="14.5" cy="22" r="1" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="problem-card__label">El aliado para el éxito</h3>
          <p class="problem-card__text">
            Mereces un equipo contable que trabaje para tu empresa,
            no solo para cumplir con SUNAT.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       4. LAS CONSECUENCIAS — Las apuestas
  ══════════════════════════════════════════ -->
  <section class="stakes" aria-labelledby="stakes-heading">
    <div class="container stakes__inner">

      <div class="stakes__text" data-reveal-left>
        <span class="eyebrow stakes__eyebrow">Lo que está en juego</span>
        <h2 class="stakes__heading" id="stakes-heading">
          Cada mes sin control real<br>es un mes de riesgo acumulado.
        </h2>
        <p class="stakes__sub">
          No actuar tiene un costo concreto. La mayoría de los problemas
          contables que terminan en multas o contingencias eran previsibles.
        </p>
      </div>

      <div class="stakes__list" data-stagger>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Multas por declaraciones fuera de plazo o incorrectas</span>
        </div>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Crisis de liquidez que llegan sin aviso</span>
        </div>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Decisiones de inversión sin respaldo financiero real</span>
        </div>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Contingencias tributarias que se acumulan silenciosamente</span>
        </div>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Pérdida de tiempo gerencial resolviendo problemas contables</span>
        </div>
        <div class="stakes__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2L2 5.5v4C2 13.1 5.1 16.4 9 17.2c3.9-.8 7-4.1 7-7.7v-4L9 2z" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Crecer sin saber si el crecimiento es rentable</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       5. EL GUÍA — Somos la solución (empatía + autoridad)
  ══════════════════════════════════════════ -->
  <section class="section guide" aria-labelledby="guide-heading">
    <div class="container guide__inner">

      <div class="guide__text" data-reveal-left>
        <span class="eyebrow">Por qué Grupo Castañeda</span>
        <h2 class="section-title" id="guide-heading">
          Entendemos lo que sientes.<br>
          <em>Y sabemos cómo resolverlo.</em>
        </h2>
        <div class="gold-line"></div>
        <p>
          Hemos trabajado con más de 150 empresas en Lima. Sabemos que el empresario
          no quiere ser contador — quiere tener la certeza de que su empresa está bien,
          y poder enfocarse en lo que realmente le corresponde: crecer.
        </p>
        <p>
          Por eso no somos un estudio que "entrega declaraciones". Somos el área
          contable de tu empresa: integrada, proactiva, y siempre disponible.
        </p>
      </div>

      <div class="guide__credentials" data-stagger>

        <div class="credential">
          <span class="credential__num" data-counter="10" data-suffix="+">10+</span>
          <div>
            <strong class="credential__title">Años de experiencia</strong>
            <p class="credential__desc">Acompañando empresas en Lima desde su etapa inicial hasta su consolidación.</p>
          </div>
        </div>

        <div class="credential">
          <span class="credential__num" data-counter="150" data-suffix="+">150+</span>
          <div>
            <strong class="credential__title">Empresas atendidas</strong>
            <p class="credential__desc">De todos los rubros: comercio, servicios, logística, tecnología, construcción y más.</p>
          </div>
        </div>

        <div class="credential">
          <span class="credential__num">4</span>
          <div>
            <strong class="credential__title">Áreas integradas</strong>
            <p class="credential__desc">Contabilidad, planillas, tesorería y tributación bajo un mismo equipo coordinado.</p>
          </div>
        </div>

      </div>

    </div>

    <div class="container guide__media-panel" data-reveal>
      <div class="img-slot img-slot--wide" data-img="guide-equipo">
        <span class="img-slot__label">El equipo Grupo Castañeda</span>
        <span class="img-slot__hint">Foto de presentación · ~1200 × 560 px</span>
      </div>
      <a href="/nosotros" class="btn btn--outline guide__btn">Conoce nuestro equipo</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       6. EL PLAN — 3 pasos simples
  ══════════════════════════════════════════ -->
  <section class="section plan" aria-labelledby="plan-heading">
    <div class="container">

      <div class="section-header section-header--center" data-reveal>
        <span class="eyebrow">Así de simple</span>
        <h2 class="section-title" id="plan-heading">
          Tres pasos para tener<br>el área contable que mereces.
        </h2>
        <div class="gold-line" style="margin-inline: auto;"></div>
      </div>

      <div class="plan__steps" data-stagger>

        <div class="plan__step">
          <div class="plan__step-num" aria-hidden="true">01</div>
          <div class="plan__connector" aria-hidden="true"></div>
          <h3 class="plan__step-title">Conversamos</h3>
          <p class="plan__step-desc">
            Una llamada de 30 minutos para entender tu empresa, tu situación
            actual y lo que necesitas. Sin compromiso, sin tecnicismos.
          </p>
        </div>

        <div class="plan__step">
          <div class="plan__step-num" aria-hidden="true">02</div>
          <div class="plan__connector" aria-hidden="true"></div>
          <h3 class="plan__step-title">Diseñamos tu esquema</h3>
          <p class="plan__step-desc">
            Definimos las áreas que necesitas, hacemos la transición ordenada
            desde tu contador o estudio anterior, y ponemos todo al día.
          </p>
        </div>

        <div class="plan__step">
          <div class="plan__step-num" aria-hidden="true">03</div>
          <h3 class="plan__step-title">Tu empresa, siempre al día</h3>
          <p class="plan__step-desc">
            A partir de ese momento tienes un equipo dedicado, alertas preventivas,
            reportes mensuales y respuesta garantizada en el día.
          </p>
        </div>

      </div>

      <div class="plan__cta" data-reveal>
        <a href="/conversemos" class="btn btn--primary">
          Empezar ahora
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       7. SERVICIOS — Preview de las 4 áreas
  ══════════════════════════════════════════ -->
  <section class="section services" aria-labelledby="services-heading">
    <div class="container">

      <div class="section-header" data-reveal>
        <span class="eyebrow">Lo que hacemos</span>
        <h2 class="section-title" id="services-heading">Cuatro áreas. Un solo equipo.</h2>
        <div class="gold-line"></div>
        <p class="section-desc">
          Cada área trabaja en coordinación para darte una visión financiera
          completa y preventiva de tu empresa.
        </p>
      </div>

      <div class="services__grid" data-stagger>

        <div class="service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="3" width="20" height="23" rx="2" stroke="currentColor" stroke-width="1.2"/>
              <line x1="8" y1="10" x2="20" y2="10" stroke="currentColor" stroke-width="1.2"/>
              <line x1="8" y1="15" x2="20" y2="15" stroke="currentColor" stroke-width="1.2"/>
              <line x1="8" y1="20" x2="15" y2="20" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
          <h3 class="service-card__title">Contabilidad</h3>
          <p class="service-card__desc">Registro riguroso, estados financieros reales y análisis mensual que te permite decidir con datos.</p>
          <span class="service-card__tag">NIIF / PCGE</span>
        </div>

        <div class="service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <circle cx="14" cy="9" r="5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M5 25c0-4.97 4.03-9 9-9s9 4.03 9 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="service-card__title">Planillas</h3>
          <p class="service-card__desc">Cálculo de remuneraciones, AFP/ONP, gratificaciones, CTS y presentación puntual ante SUNAT.</p>
          <span class="service-card__tag">T-Registro / PLM</span>
        </div>

        <div class="service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="3" y="7" width="22" height="16" rx="2" stroke="currentColor" stroke-width="1.2"/>
              <path d="M3 12h22" stroke="currentColor" stroke-width="1.2"/>
              <circle cx="9" cy="18" r="2" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
          <h3 class="service-card__title">Tesorería</h3>
          <p class="service-card__desc">Control de flujo de caja, conciliaciones bancarias y alertas preventivas de liquidez.</p>
          <span class="service-card__tag">Flujo de caja</span>
        </div>

        <div class="service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 3L3 8.5v5.5c0 6.4 4.8 11.4 11 12.7C20.2 25.4 25 20.4 25 14v-5.5L14 3z" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 14l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="service-card__title">Tributación</h3>
          <p class="service-card__desc">Planificación tributaria, declaraciones, atención de fiscalizaciones y estrategias para reducir la carga fiscal.</p>
          <span class="service-card__tag">SUNAT / PDT</span>
        </div>

      </div>

      <div class="services__more" data-reveal>
        <a href="/servicios" class="btn btn--outline">Ver detalle de servicios</a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       8. BENEFICIOS — Value stack
  ══════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-heading">
    <div class="container">

      <div class="section-header" data-reveal>
        <span class="eyebrow">Lo que incluye</span>
        <h2 class="section-title" id="benefits-heading">
          Todo lo que necesita<br>tu empresa, integrado.
        </h2>
        <div class="gold-line"></div>
      </div>

      <div class="benefits__grid" data-stagger>

        <div class="benefit">
          <div class="benefit__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M4 11l4 4 10-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3 class="benefit__title">Equipo dedicado a tu empresa</h3>
            <p class="benefit__desc">Un contador principal asignado, con nombre y apellido. Siempre sabes a quién escribirle.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="benefit__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M4 11l4 4 10-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3 class="benefit__title">Respuesta garantizada en el día</h3>
            <p class="benefit__desc">Ninguna consulta queda sin respuesta por más de 24 horas hábiles.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="benefit__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
