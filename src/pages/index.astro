</style>

<script>
  import { gsap } from 'gsap';

  // ── Hero: la pregunta del titular y la pestaña del informe cambian juntas ──
  const PHRASES = [
    'cuánto ganas?',
    'si tu planilla cumple?',
    'si hay caja este mes?',
    'qué retiene SUNAT?',
  ];
  const CYCLE = 4.6; // segundos por área

  const word = document.getElementById('heroWord');
  const panelRoot = document.getElementById('gcPanel');
  const progress = document.getElementById('gcProgress');
  const tabs = panelRoot ? Array.from(panelRoot.querySelectorAll('.gcp__tab')) : [];
  const panels = panelRoot ? Array.from(panelRoot.querySelectorAll('.gcp__panel')) : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const formatNum = (n: number) => n.toLocaleString('es-PE');

  function animateCounters(panel: Element) {
    panel.querySelectorAll<HTMLElement>('[data-gc-count]').forEach((el) => {
      const target = parseInt(el.dataset.gcCount ?? '0', 10);
      if (reduceMotion) { el.textContent = formatNum(target); return; }
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 1.3,
        ease: 'power2.out',
        onUpdate: () => { el.textContent = formatNum(Math.round(obj.v)); },
        onComplete: () => { el.textContent = formatNum(target); },
      });
    });
  }

  // Reinicia las animaciones CSS de un panel (barras, línea, filas) al mostrarlo
  function restartPanel(panel: HTMLElement) {
    panel.hidden = false;
    panels.forEach((p) => { if (p !== panel) { p.classList.remove('is-active'); (p as HTMLElement).hidden = true; } });
    const clone = panel.cloneNode(true) as HTMLElement;
    panel.replaceWith(clone);
    panels[panels.indexOf(panel)] = clone;
    clone.classList.add('is-active');
    animateCounters(clone);
    return clone;
  }

  let current = 0;
  let timer: gsap.core.Tween | null = null;
  let progressTween: gsap.core.Tween | null = null;
  let paused = false;

  function swapWord(text: string) {
    if (!word) return;
    if (reduceMotion) { word.textContent = text; return; }
    gsap.timeline()
      .to(word, { y: -14, opacity: 0, duration: 0.32, ease: 'power2.in' })
      .add(() => { word.textContent = text; })
      .fromTo(word, { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' });
  }

  function show(n: number) {
    current = (n + PHRASES.length) % PHRASES.length;
    tabs.forEach((t, i) => {
      t.classList.toggle('is-active', i === current);
      t.setAttribute('aria-selected', String(i === current));
    });
    const panel = panels[current] as HTMLElement | undefined;
    if (panel) restartPanel(panel);
    swapWord(PHRASES[current]);

    if (progress) {
      progressTween?.kill();
      gsap.set(progress, { x: `${current * 100}%`, scaleX: 0 });
      if (!reduceMotion) {
        progressTween = gsap.to(progress, { scaleX: 1, duration: CYCLE, ease: 'none' });
      } else {
        gsap.set(progress, { scaleX: 1 });
      }
    }
    schedule();
  }

  function schedule() {
    timer?.kill();
    if (reduceMotion || paused) return;
    timer = gsap.delayedCall(CYCLE, () => show(current + 1));
  }

  if (panelRoot && panels.length) {
    tabs.forEach((t) => t.addEventListener('click', () => show(parseInt(t.dataset.tab ?? '0', 10))));

    // Al pasar el mouse por el informe se detiene el ciclo (para leerlo)
    panelRoot.addEventListener('mouseenter', () => { paused = true; timer?.kill(); progressTween?.pause(); });
    panelRoot.addEventListener('mouseleave', () => { paused = false; progressTween?.resume(); schedule(); });

    // Solo corre cuando el hero está en pantalla
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { paused = false; progressTween?.resume(); schedule(); }
        else { paused = true; timer?.kill(); progressTween?.pause(); }
      });
    }, { threshold: 0.25 });
    io.observe(panelRoot);

    animateCounters(panels[0]);
    if (progress && !reduceMotion) {
      gsap.set(progress, { x: '0%', scaleX: 0 });
      progressTween = gsap.to(progress, { scaleX: 1, duration: CYCLE, ease: 'none' });
    }
    schedule();
  }
</script>
