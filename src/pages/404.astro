---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada — Grupo Castañeda"
  description="La página que buscas no existe o cambió de lugar."
>
  <section class="nf">
    <div class="container nf__inner">
      <span class="eyebrow">Error 404</span>
      <h1 class="nf__heading">Esta página <em>no existe.</em></h1>
      <p class="nf__sub">
        Puede que el enlace haya cambiado de lugar. Vuelve al inicio o escríbenos y te ayudamos.
      </p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">Ir al inicio</a>
        <a href="/conversemos" class="btn btn--outline">Conversemos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 12rem 0 8rem;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .nf__inner { max-width: 640px; }
  .nf__heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.1;
    margin: 1rem 0 1.25rem;
  }
  .nf__heading em { font-style: italic; color: var(--color-gold); }
  .nf__sub { color: rgba(255, 255, 255, 0.8); margin-bottom: 2rem; }
  .nf__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
